{
  "manifest_version": 3,
  "name": "Token Saver - Universal Translator",
  "version": "5.1.2",
  "description": "Translate chat drafts before sending with Enter or the send button. Includes a language selector and draggable toggle.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Token Saver",
    "default_icon": {
      "16": "assets/brand/icon-16.png",
      "32": "assets/brand/icon-32.png"
    }
  },
  "icons": {
    "16": "assets/brand/icon-16.png",
    "32": "assets/brand/icon-32.png",
    "48": "assets/brand/icon-48.png",
    "128": "assets/brand/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://*.claude.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
