{
  "manifest_version": 3,
  "name": "Token Saver - Universal Translator",
  "version": "5.1.1",
  "description": "Translate chat drafts before sending with Enter or the send button. Includes a language selector and draggable toggle.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Token Saver"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://*.claude.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
